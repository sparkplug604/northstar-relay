.relay-job-detail-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.75rem;
}
.relay-job-detail-heading > div:first-child { min-width: 0; overflow-wrap: anywhere; }
.relay-job-detail-heading h1 { margin-top: 0; }
.relay-job-detail-heading p { margin: 0.35rem 0; }
.relay-job-detail-tools { display: grid; justify-items: end; text-align: right; gap: 0.35rem; }
.relay-job-detail-tools button { font-size: 0.875rem; }
.relay-job-detail-menu summary { cursor: pointer; font-weight: 650; padding: 0.625rem 0; }
.relay-job-detail-menu .relay-actions { margin-bottom: 0.5rem; }

.relay-job-row {display:flex;align-items:center;gap:1.5rem;margin-bottom:.75rem;}
.relay-job-row>div {min-width:0;flex:1;}
.relay-job-row p {font-size:.9rem;color:var(--relay-muted);margin:.15rem 0 .5rem;overflow-wrap:anywhere;}
.relay-job-row dl {display:grid;grid-template-columns:1fr 1.2fr;gap:1rem;flex:1.5;margin:0;}
.relay-job-row dt {font-size:.78rem;color:var(--relay-muted);}
.relay-job-row dd {margin:.3rem 0;font-size:.88rem;overflow-wrap:anywhere;}
.relay-job-status-blocked {background:#fbe3df;color:#962e28;}
.relay-job-status-completion_reported,.relay-job-status-scheduled {background:#fff1ce;color:#7b5318;}
.relay-job-status-in_progress,.relay-job-status-completed {background:#e0f0e5;color:#1a6247;}
.relay-job-detail>.relay-job-primary-actions {position:sticky;top:.5rem;z-index:10;}
.relay-job-detail .relay-embedded-ack .relay-work-action-rail {position:static;}
.relay-job-detail .relay-section-heading h2 {margin:0;}
.relay-job-detail .relay-work-next {max-width:70%;}
.relay-job-detail .relay-note {overflow-wrap:anywhere;white-space:pre-wrap;}
.relay-job-milestones {list-style:none;padding:0;margin:0;}
.relay-job-milestones li {display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:1rem 0;border-top:1px solid var(--relay-border);}
.relay-job-milestones li>div:first-child {min-width:0;overflow-wrap:anywhere;}
.relay-job-milestones small {margin:.25rem 0;}
.relay-job-milestones .relay-actions {justify-content:flex-end;flex-shrink:0;}
.relay-job-completion {align-self:start;}
.relay-job-filters {flex-wrap:wrap;align-items:end;}
.relay-job-filters>label {min-width:150px;flex:1;}
.relay-attention-reasons {font-size:.84rem;color:#8a352c;padding-left:1.15rem;margin:.6rem 0;}
.relay-timezone {margin:0 0 1rem;}
.relay-ack-workspace {scroll-margin-top:180px;border-top:1px solid var(--relay-border);padding-top:1.5rem;margin-top:.5rem;}
.relay-embedded-ack>.relay-section-heading {margin-top:.25rem;}
.relay-audit-time {position:relative;display:inline-block!important;text-decoration:underline dotted;text-underline-offset:3px;}
.relay-exact-time {display:none;position:absolute;left:0;top:100%;z-index:30;background:#15332e;color:white;padding:.4rem .6rem;border-radius:5px;font-size:.75rem;white-space:nowrap;font-weight:400;}
.relay-audit-time:focus .relay-exact-time,.relay-audit-time:hover .relay-exact-time {display:block;}
@media(max-width:760px){
  .relay-job-row {flex-wrap:wrap;gap:1rem;}
  .relay-job-row>div,.relay-job-row dl {flex-basis:100%;}
  .relay-job-row>button {width:100%;}
  .relay-job-milestones li {align-items:stretch;flex-direction:column;}
  .relay-job-milestones .relay-actions {justify-content:flex-start;}
  .relay-job-detail .relay-work-next {max-width:none;}
  .relay-job-primary-actions .relay-work-next>.relay-actions {width:100%;}
  .relay-job-primary-actions .relay-work-next>.relay-actions button {flex:1;}
  .relay-job-primary-actions .relay-work-secondary {flex-wrap:nowrap;overflow-x:auto;max-width:100%;padding-bottom:3px;}
  .relay-job-primary-actions .relay-work-secondary button {flex:0 0 auto;}
  .relay-ack-workspace {scroll-margin-top:260px;}
  .relay-nav {overflow-x:auto;}
  .relay-nav a {flex:none;min-width:64px;padding:.5rem;white-space:nowrap;}
}
