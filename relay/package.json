{
  "name": "northstar-relay",
  "version": "0.0.1",
  "private": true,
  "description": "Northstar Relay service dispatch",
  "type": "module",
  "workspaces": [
    "packages/relay-*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspace @northstar/relay-domain && npm run build --workspace @northstar/relay-adapters && npm run build --workspace @northstar/relay-storage-postgres && tsc -p tsconfig.json",
    "build:web": "VITE_RELAY_PLANNING_DEMO=true vite build --config apps/web/vite.config.ts",
    "build:all": "npm run build && npm run build:web",
    "test": "npm run build && node --test dist/test/relay-*.test.js packages/relay-domain/dist/test/*.test.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/luxon": "^3.7.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/static": "^10.1.3",
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/luxon3": "^6.1.22",
    "@fullcalendar/react": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "fastify": "^5.12.1",
    "luxon": "^3.7.2",
    "mailparser": "^3.9.20",
    "maplibre-gl": "^6.16.0",
    "otpauth": "^9.5.2",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "twilio": "^6.1.0",
    "zod": "^4.5.1"
  }
}
